# Copy to .env and adjust. Every value is optional in development.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://vault.example.com

# Database (defaults to SQLite at backend/db.sqlite3 when unset)
# DATABASE_URL=postgres://username:password@localhost:5432/vaultify_db

# Encryption key(s) for vault secrets. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several keys to rotate: the first encrypts, all can decrypt.
# VAULT_ENCRYPTION_KEY=

# Security
VAULT_SESSION_TIMEOUT=1800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
